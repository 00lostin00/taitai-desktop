<Window x:Class="Taitai.Desktop.ChatStatusWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="苔苔 · 当前聊天" Width="308" Height="84" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" ShowActivated="False" UseLayoutRounding="True">
 <Grid x:Name="Root" Width="308" Height="84" HorizontalAlignment="Left" VerticalAlignment="Top">
  <Button x:Name="ChatCard" Width="284" Height="56" Margin="12,10,12,18" Click="OpenChat" AutomationProperties.Name="返回当前 ChatGPT 聊天">
   <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="Card" Background="#F7FFFFFF" CornerRadius="26" Padding="17,9"><Border.Effect><DropShadowEffect Color="Black" Opacity="0.16" BlurRadius="15" ShadowDepth="4" Direction="270"/></Border.Effect><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="White"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#777777"/><Setter TargetName="Card" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
   <StackPanel><TextBlock x:Name="Heading" FontSize="12" FontWeight="SemiBold" Foreground="#303030" TextTrimming="CharacterEllipsis" Text="当前聊天"/><TextBlock x:Name="Status" FontSize="11" Foreground="#686868" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" Text="等待会话状态"/></StackPanel>
  </Button>
 </Grid>
</Window>
