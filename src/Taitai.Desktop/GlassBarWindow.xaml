<Window x:Class="Taitai.Desktop.GlassBarWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="苔苔 · 额度工具条" Width="246" Height="60" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" ShowActivated="False" UseLayoutRounding="True">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#404040"/><Setter Property="FontFamily" Value="Segoe UI,Microsoft YaHei UI"/><Setter Property="FontSize" Value="11"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Segment" CornerRadius="12" Background="{TemplateBinding Background}" Margin="1,3" BorderThickness="0"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Segment" Property="Background" Value="#10000000"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Segment" Property="Background" Value="#1C000000"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Segment" Property="BorderBrush" Value="#737373"/><Setter TargetName="Segment" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid x:Name="Root" Width="246" Height="60" HorizontalAlignment="Left" VerticalAlignment="Top">
  <Border Width="222" Height="32" Margin="12,10,12,18" CornerRadius="16" Background="#F5FFFFFF">
   <Border.Effect><DropShadowEffect Color="#000000" Opacity="0.18" BlurRadius="15" ShadowDepth="4" Direction="270"/></Border.Effect>
   <Grid Margin="5,0"><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="1"/><ColumnDefinition Width="64"/><ColumnDefinition Width="1"/><ColumnDefinition Width="56"/><ColumnDefinition Width="1"/><ColumnDefinition Width="53"/></Grid.ColumnDefinitions>
    <Button x:Name="ChatButton" Click="OpenChat" ToolTip="返回关联的 ChatGPT 聊天" AutomationProperties.Name="返回 ChatGPT 聊天"><Viewbox Width="15" Height="15"><Canvas Width="20" Height="20"><Path Data="M 12,3 L 17,3 L 17,8 M 16,4 L 8,12 M 11,5 L 5,5 Q 3,5 3,7 L 3,15 Q 3,17 5,17 L 13,17 Q 15,17 15,15 L 15,11" Stroke="#575757" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/></Canvas></Viewbox></Button>
    <Border Grid.Column="1" Height="14" Background="#16000000" VerticalAlignment="Center" IsHitTestVisible="False"/>
    <Button x:Name="ShortButton" Grid.Column="2" Click="OpenDetails" Content="查询中" AutomationProperties.Name="短时额度与重置时间"/>
    <Border Grid.Column="3" Height="14" Background="#16000000" VerticalAlignment="Center" IsHitTestVisible="False"/>
    <Button x:Name="WeekButton" Grid.Column="4" Click="OpenDetails" Content="每周 —" AutomationProperties.Name="每周额度与重置时间"/>
    <Border Grid.Column="5" Height="14" Background="#16000000" VerticalAlignment="Center" IsHitTestVisible="False"/>
    <Button x:Name="StatusButton" Grid.Column="6" Click="ToggleChat" Content="陪你待着" AutomationProperties.Name="展开或收起当前聊天状态"/>
   </Grid>
  </Border>
 </Grid>
</Window>
